   </BuildAction>
   <TestAction buildConfiguration = "Debug" selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB" selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB" shouldUseLaunchSchemeArgsEnv = "NO">
      <!--
         The end-to-end suite reads FKS_TEST_URL and FKS_TEST_TOKEN, but the
         test host runs inside the simulator and inherits neither your shell's
         environment nor build settings. Pass them with the TEST_RUNNER_ prefix,
         which xcodebuild forwards to the runner with the prefix stripped:

           TEST_RUNNER_FKS_TEST_URL=https://host:8443 \
           TEST_RUNNER_FKS_TEST_TOKEN=... \
           xcodebuild test ...

         Absent, the suite skips itself.
      -->
      <!--
         Tests run against the local StoreKit configuration too, so a purchase
         path can be exercised without a sandbox Apple ID.
      -->
      <StoreKitConfigurationFileReference
         identifier = "../../../FinanceKitSync/FinanceKitSync.storekit">
      </StoreKitConfigurationFileReference>
      <Testables>
         <TestableReference skipped = "NO">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "FK00000000000000000024"
               BuildableName = "FinanceKitSyncTests.xctest"
               BlueprintName = "FinanceKitSyncTests"
               ReferencedContainer = "container:FinanceKitSync.xcodeproj">
            </BuildableReference>
         </TestableReference>
      </Testables>
   </TestAction>
   <LaunchAction buildConfiguration = "Debug" selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB" selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB" launchStyle = "0" useCustomWorkingDirectory = "NO" ignoresPersistentStateOnLaunch = "NO" debugDocumentVersioning = "YES" debugServiceExtension = "internal" allowLocationSimulation = "YES">
      <BuildableProductRunnable runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "FK00000000000000000012"
            BuildableName = "FinanceKitSync.app"
            BlueprintName = "FinanceKitSync"
            ReferencedContainer = "container:FinanceKitSync.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
      <!--
         Debug runs use the local StoreKit configuration: the paywall, the
         trial, renewals, expiry and refunds are all exercisable in the
         simulator with no sandbox account. It is never consulted by a build
         installed any other way — TestFlight and the App Store use the real
         store.
      -->
      <StoreKitConfigurationFileReference
         identifier = "../../../FinanceKitSync/FinanceKitSync.storekit">
      </StoreKitConfigurationFileReference>
   </LaunchAction>
