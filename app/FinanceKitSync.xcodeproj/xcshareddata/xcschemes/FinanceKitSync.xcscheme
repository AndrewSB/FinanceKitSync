   <BuildAction parallelizeBuildables = "YES" buildImplicitDependencies = "YES">
      <BuildActionEntries>
         <BuildActionEntry buildForTesting = "YES" buildForRunning = "YES" buildForProfiling = "YES" buildForArchiving = "YES" buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "FK00000000000000000012"
               BuildableName = "FinanceKitSync.app"
               BlueprintName = "FinanceKitSync"
               ReferencedContainer = "container:FinanceKitSync.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
         <BuildActionEntry buildForTesting = "YES" buildForRunning = "NO" buildForProfiling = "NO" buildForArchiving = "NO" buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "FK00000000000000000024"
               BuildableName = "FinanceKitSyncTests.xctest"
               BlueprintName = "FinanceKitSyncTests"
               ReferencedContainer = "container:FinanceKitSync.xcodeproj">
